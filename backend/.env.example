# Express App Configuration
PORT=5000
JWT_SECRET=customer-pulse-super-secret-key-change-me

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration Type
# Options: 'mssql', 'mysql', or 'firebase' (or omit/leave empty to run mock Firestore)
DB_TYPE=mssql

# MySQL / Percona Server Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YourStrongRootPasswordHere
DB_DATABASE=customer_pulse

# Microsoft SQL Server Configuration
# Connects to your local or remote SQL Server Express instance
DB_SERVER=localhost
# If using a named instance like SQLEXPRESS, specify it here (otherwise leave blank)
DB_INSTANCE=
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPasswordHere
DB_DATABASE=CustomerPulse
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# LDAP / Active Directory Integration Configuration
LDAP_ENABLED=false
LDAP_URL=ldap://your-ldap-server:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=adminpassword
LDAP_SEARCH_BASE=dc=example,dc=com
LDAP_USER_SEARCH_FILTER=(sAMAccountName={{username}})

# Firebase Admin SDK Credentials (Legacy / Fallback)
# Specify absolute path to your firebase service account JSON file.
FIREBASE_SERVICE_ACCOUNT_KEY=
