# Express App Configuration
PORT=5000
JWT_SECRET=customer-pulse-super-secret-key-change-me

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Credentials
# Specify absolute path to your firebase service account JSON file.
# If omitted, server falls back to high-fidelity mock databases automatically!
FIREBASE_SERVICE_ACCOUNT_KEY=C:/path/to/firebase-adminsdk-key.json
