# ─────────────────────────────────────────────────────────
# Customer Pulse CRM — Backend Environment Configuration
# Nest Digital Internal | PostgreSQL + LDAP + RBAC
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# Express App
PORT=5000
JWT_SECRET=change-this-to-a-secure-random-string

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────
# Database — PostgreSQL
# ─────────────────────────────────────────────────────────
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=customer_pulse

# ─────────────────────────────────────────────────────────
# LDAP / Active Directory
# ─────────────────────────────────────────────────────────
# LDAP_ENABLED=true   — authenticate against real AD
# LDAP_ENABLED=mock   — simulate LDAP flow (no live server needed)
# LDAP_ENABLED=false  — use local PostgreSQL password auth only
LDAP_ENABLED=false

LDAP_URL=ldap://YOUR_LDAP_SERVER:389
LDAP_SEARCH_BASE=DC=your,DC=domain,DC=com

# Service account (needs read access to the user OU)
LDAP_BIND_DN=serviceaccount@yourdomain.com
LDAP_BIND_PASSWORD=your_service_account_password

# Bind attribute for Nest Digital Active Directory:
#   userPrincipalName  (user@nestgroup.net format — recommended for AD)
#   dn                 (full distinguished name — for OpenLDAP)
LDAP_BIND_ATTRIBUTE=userPrincipalName

# Login attribute — the field users type when signing in
# sAMAccountName  — short Windows login (recommended for AD)
# mail            — email address
# uid             — for OpenLDAP
LDAP_LOGIN_ATTRIBUTE=sAMAccountName

# Domain suffix used to construct UPN: username + "@" + LDAP_DOMAIN
LDAP_DOMAIN=yourdomain.com

# Filter template ({{username}} replaced at runtime with sAMAccountName value)
LDAP_USER_SEARCH_FILTER=(sAMAccountName={{username}})
