rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user record from the users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper functions for roles
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'Admin';
    }

    function isExecutive() {
      return isAuthenticated() && getUserData().role == 'Executive';
    }

    function isSalesManager() {
      return isAuthenticated() && getUserData().role == 'Sales Manager';
    }

    function isEmployee() {
      return isAuthenticated() && getUserData().role == 'Employee';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Accounts collection
    match /accounts/{accountId} {
      allow read: if isAdmin() || isExecutive() || isSalesManager() || isEmployee();
      allow write: if isAdmin() || isSalesManager();
    }

    // Contacts collection
    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSalesManager() || isEmployee();
    }

    // Interactions collection
    match /interactions/{interactionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Risks collection
    match /risks/{riskId} {
      allow read: if isAdmin() || isExecutive() || isSalesManager();
      allow write: if isAdmin() || isSalesManager();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Summaries collection
    match /summaries/{summaryId} {
      allow read: if isAdmin() || isExecutive() || isSalesManager();
      allow write: if isAdmin() || isSalesManager();
    }

    // HealthScores collection
    match /healthScores/{scoreId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSalesManager();
    }
  }
}
